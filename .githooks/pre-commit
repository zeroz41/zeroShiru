#!/bin/sh
# Blocks debrid API keys from being committed. Enable with:
#   git config core.hooksPath .githooks
set -e

fail() {
  echo "pre-commit: refusing to commit, this looks like a live API key:" >&2
  echo "$1" >&2
  echo "" >&2
  echo "Keep keys in .env (gitignored) or the shell environment. See BUILDING.md." >&2
  echo "If this is a false positive: git commit --no-verify" >&2
  exit 1
}

env_files=$(git diff --cached --name-only --diff-filter=AM | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' || true)
[ -n "$env_files" ] && fail "$env_files"

hits=$(git diff --cached --name-only --diff-filter=AM | while read -r f; do
  [ -f "$f" ] || continue
  git show ":$f" 2>/dev/null | grep -nE '(REAL_DEBRID_API_KEY|TORBOX_API_KEY|ALLDEBRID_API_KEY|PREMIUMIZE_API_KEY)[":= ]+[A-Za-z0-9_-]{16,}' | sed "s|^|$f:|" || true
done)
[ -n "$hits" ] && fail "$hits"

exit 0
