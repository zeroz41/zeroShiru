# Copy to .env at the repository root (gitignored). The live test suites read it
# automatically. Every key is optional - a service with no key skips its tests.

# Debrid service API keys
REAL_DEBRID_API_KEY=
TORBOX_API_KEY=

# Optional fixtures. Without these the tests that need them skip.
# An info hash TorBox reports as cached; defaults to a public-domain release.
TORBOX_TEST_HASH=
# A cached MKV release, ideally a season pack: the Rust live tests pick an episode out
# of it, and the JS playback tests stream its subtitles, fonts and chapters. Both
# optional - the Rust side falls back to the largest multi-file torrent on the account
# and the median episode its file names parse to.
TB_TEST_PACK_HASH=
TB_TEST_PACK_EPISODE=
# A magnet/hash cached on Real-Debrid, for its live tests.
RD_TEST_MAGNET=
