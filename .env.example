# Copy to .env (gitignored) and fill in what you have. `pnpm test:live` reads it
# automatically. Every key is optional - a service with no key skips its tests.

# Debrid service API keys
REAL_DEBRID_API_KEY=
TORBOX_API_KEY=

# Optional fixtures. Without these the tests that need them skip.
# A magnet/hash already cached on the account, used for resolve and playback tests.
RD_TEST_MAGNET=
# A season pack, plus the episode number to pick out of it.
RD_TEST_PACK_MAGNET=
RD_TEST_PACK_EPISODE=
# An info hash TorBox reports as cached.
TORBOX_TEST_HASH=
