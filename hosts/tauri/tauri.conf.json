{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zeroShiru",
  "version": "6.8.0",
  "identifier": "watch.zeroshiru.app",
  "build": {
    "devUrl": "http://localhost:5173/app.html",
    "frontendDist": "../../dist/web",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "msi",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "shiru",
          "magnet"
        ]
      }
    }
  }
}
