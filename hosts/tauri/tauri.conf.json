{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shiru",
  "version": "6.8.0",
  "identifier": "watch.shiru.app",
  "build": {
    "devUrl": "http://localhost:5173/app.html",
    "frontendDist": "../../dist/web",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Shiru",
        "width": 1280,
        "height": 800,
        "minWidth": 320,
        "minHeight": 390,
        "backgroundColor": "#17191c",
        "url": "app.html"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "msi",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "shiru",
          "magnet"
        ]
      }
    }
  }
}
