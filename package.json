{
  "name": "zeroshiru",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "author": "zeroz <zeroz@none.cx>",
  "description": "A personal anime library manager for watching and tracking your collection in real time. Lightweight, powerful, and paws-itively fast. No waiting required!",
  "homepage": "https://github.com/zeroz41/zeroShiru#readme",
  "scripts": {
    "test": "bun test --preload ./test/bun-register.js test/unit",
    "test:watch": "bun test --watch --preload ./test/bun-register.js test/unit",
    "test:live": "bun test --preload ./test/bun-register.js --timeout 120000 test/live",
    "test:rust": "cargo test --workspace",
    "test:rust:live": "cargo test -p shiru-debrid --features native --test live -- --ignored --nocapture",
    "test:torrent": "cargo run -p shiru-torrent --features native --example smoke",
    "build": "cross-env NODE_ENV=production vite build common",
    "tauri:dev": "concurrently --kill-others \"vite common\" \"cargo run -p shiru-tauri\"",
    "tauri:build": "cross-env NODE_ENV=production vite build common && cargo build --release -p shiru-tauri",
    "tauri:bundle": "cross-env NODE_ENV=production vite build common && cd hosts/tauri && cargo tauri build",
    "android:build": "cross-env NODE_ENV=production vite build common && cd hosts/tauri && cargo tauri android build --apk",
    "tv:core": "./scripts/build-tv-core.sh"
  },
  "dependencies": {
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-svelte": "^3.22.0",
    "vite": "^5.4.21"
  },
  "workspaces": [
    "common",
    "extensions"
  ],
  "patchedDependencies": {
    "rfdc@1.4.1": "patches/rfdc.patch",
    "svelte-keybinds@1.0.9": "patches/svelte-keybinds.patch"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
